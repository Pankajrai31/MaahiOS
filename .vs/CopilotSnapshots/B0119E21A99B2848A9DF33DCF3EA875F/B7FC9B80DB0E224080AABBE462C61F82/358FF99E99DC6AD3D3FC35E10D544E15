/**
 * Disk Manager Application
 * Windows-style disk view with rectangles for each drive
 */

#include <stdint.h>
#include "../../syscalls/user_syscalls.h"

// Drive types from ATA driver
#define DRIVE_TYPE_UNKNOWN 0
#define DRIVE_TYPE_ATA     1  // HDD
#define DRIVE_TYPE_ATAPI   2  // CD/DVD

// Disk info structure (must match kernel's disk_info_t exactly)
typedef struct {
    uint8_t active;
    uint8_t disk_type;
    uint8_t fs_type;
    uint8_t drive_letter;
    uint8_t ata_drive_id;
    uint32_t size_mb;
    char label[32];
    char type_str[16];
    char fs_str[16];
} __attribute__((packed)) disk_info_t;

// Colors
#define COLOR_BLUE      0x0066CC
#define COLOR_GRAY      0x808080
#define COLOR_DARKGRAY  0x404040
#define COLOR_WHITE     0xFFFFFF

// UI syscall wrappers
static int ui_create_window(int x, int y, int w, int h, const char *title, int parent) {
    int result;
    register int _x __asm__("ebx") = x;
    register int _y __asm__("ecx") = y;
    register int _w __asm__("edx") = w;
    register int _h __asm__("esi") = h;
    
    __asm__ volatile(
        "push %6\n"
        "push %5\n"
        "mov $40, %%eax\n"
        "int $0x80\n"
        "add $8, %%esp\n"
        : "=a"(result)
        : "b"(_x), "c"(_y), "d"(_w), "S"(_h), "r"(title), "r"(parent)
        : "memory"
    );
    return result;
}

static int ui_create_button(int window_id, int x, int y, int w, int h, const char *text) {
    int result;
    register int _wid __asm__("ebx") = window_id;
    register int _x __asm__("ecx") = x;
    register int _y __asm__("edx") = y;
    register int _w __asm__("esi") = w;
    
    __asm__ volatile(
        "push %6\n"
        "push %5\n"
        "mov $41, %%eax\n"
        "int $0x80\n"
        "add $8, %%esp\n"
        : "=a"(result)
        : "b"(_wid), "c"(_x), "d"(_y), "S"(_w), "r"(h), "r"(text)
        : "memory"
    );
    return result;
}

static int ui_create_label(int window_id, int x, int y, const char *text) {
    int result;
    register int _wid __asm__("ebx") = window_id;
    register int _x __asm__("ecx") = x;
    register int _y __asm__("edx") = y;
    register const char *_text __asm__("esi") = text;
    
    __asm__ volatile(
        "mov $42, %%eax\n"
        "int $0x80\n"
        : "=a"(result)
        : "b"(_wid), "c"(_x), "d"(_y), "S"(_text)
        : "memory"
    );
    return result;
}

// Get disk count from kernel
static int get_disk_count(void) {
    int result;
    __asm__ volatile(
        "mov $56, %%eax\n"
        "int $0x80\n"
        : "=a"(result)
        :
        : "memory"
    );
    return result;
}

// Get disk info for a specific index
static int get_disk_info(int index, disk_info_t *info) {
    int result;
    __asm__ volatile(
        "mov $57, %%eax\n"
        "mov %1, %%ebx\n"
        "mov %2, %%ecx\n"
        "int $0x80\n"
        : "=a"(result)
        : "r"(index), "r"(info)
        : "ebx", "ecx", "memory"
    );
    return result;
}

// Global window ID
static int g_window_id = -1;

// Draw a disk bar (long rectangle with blue label square)
static void draw_disk_bar(int y_pos, int disk_num, int is_cdrom) {
    // The disk bar is: [Blue Square with label] [Gray rectangle]
    // Blue square: 60x40 with "Disk 0" or "CD/DVD"
    // Gray bar: remaining width
    
    // Create blue label button (acts as the blue square)
    char label[12];
    if (is_cdrom) {
        // "CD/DVD"
        label[0] = 'C'; label[1] = 'D'; label[2] = '/';
        label[3] = 'D'; label[4] = 'V'; label[5] = 'D';
        label[6] = '\0';
    } else {
        // "Disk X"
        label[0] = 'D'; label[1] = 'i'; label[2] = 's';
        label[3] = 'k'; label[4] = ' '; label[5] = '0' + disk_num;
        label[6] = '\0';
    }
    
    // Blue square button at the start (x=20)
    ui_create_button(g_window_id, 20, y_pos, 60, 40, label);
    
    // Gray label showing the rest of the bar
    // We'll use a simple label for now - the gray area shows drive info
    if (is_cdrom) {
        ui_create_label(g_window_id, 90, y_pos + 12, "(C:) ISO 9660");
    } else {
        ui_create_label(g_window_id, 90, y_pos + 12, "(C:) Unallocated");
    }
}

// Scan drives and display disk bars
static void scan_and_display_drives(void) {
    int y_pos = 70;
    int disk_num = 0;
    disk_info_t info;
    
    int disk_count = get_disk_count();
    
    if (disk_count == 0) {
        ui_create_label(g_window_id, 20, y_pos, "No drives detected");
        return;
    }
    
    // Display each drive as a bar
    for (int i = 0; i < disk_count; i++) {
        if (get_disk_info(i, &info) == 0) {
            int is_cdrom = (info.disk_type == DRIVE_TYPE_ATAPI);
            draw_disk_bar(y_pos, disk_num, is_cdrom);
            
            if (!is_cdrom) {
                disk_num++;  // Only increment disk number for HDDs
            }
            
            y_pos += 50;  // Space between bars
        }
    }
}

/**
 * Disk Manager main entry point
 */
void disk_manager_main_c(void) {
    syscall_puts("[DISK_MANAGER] Starting...\n");
    
    // Create main window (wider to fit disk bars)
    g_window_id = ui_create_window(150, 120, 400, 280, "Disk Manager", 0);
    if (g_window_id < 0) {
        syscall_puts("[DISK_MANAGER] Failed to create window\n");
        while(1);
    }
    
    // Refresh button at top
    ui_create_button(g_window_id, 20, 25, 80, 25, "Refresh");
    
    // Scan and display drives
    scan_and_display_drives();
    
    syscall_puts("[DISK_MANAGER] Ready\n");
    
    // Event loop
    while(1) {
        __asm__ volatile("int $0x80" : : "a"(31) : "memory");  // yield
    }
}
